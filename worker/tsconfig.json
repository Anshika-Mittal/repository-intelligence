
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "./services",
    "outDir": "./dist",
    "types": ["node"],
    "allowJs": true,
    "checkJs": false
  },
  "include": ["services/**/*.ts"]
}